{
  "skill_name": "transcribe",
  "evals": [
    {
      "id": 1,
      "prompt": "Can you transcribe this conference welcome clip for me? It's an mp3 in the current directory.",
      "expected_output": "A transcript of the clip (transcript.txt) plus subtitle files, produced locally by cue.",
      "files": ["evals/files/clip-01.mp3"],
      "assertions": [
        {"name": "transcript is non-empty", "type": "file_nonempty", "path": "eval-basic-transcribe/with_skill/outputs/transcript.txt"},
        {"name": "transcript contains observability", "type": "contains", "path": "eval-basic-transcribe/with_skill/outputs/transcript.txt", "value": "observability", "case_insensitive": true},
        {"name": "SRT exists", "type": "file_exists", "path": "eval-basic-transcribe/with_skill/outputs/subtitles.srt"},
        {"name": "VTT exists", "type": "file_exists", "path": "eval-basic-transcribe/with_skill/outputs/subtitles.vtt"}
      ]
    },
    {
      "id": 2,
      "prompt": "Transcribe this conference welcome clip. A context file describing the talk is provided next to the clip — use it to fix any misheard names or terms in the transcript.",
      "expected_output": "A corrected transcript.txt where the speaker's name and product terms match the context file.",
      "files": ["evals/files/clip-02.mp3", "evals/files/context.md"],
      "assertions": [
        {"name": "transcript is non-empty", "type": "file_nonempty", "path": "eval-context-correction/with_skill/outputs/transcript.txt"},
        {"name": "speaker name uses Doe", "type": "contains", "path": "eval-context-correction/with_skill/outputs/transcript.txt", "value": "John Doe", "case_insensitive": true},
        {"name": "product uses OpenTelemetry", "type": "contains", "path": "eval-context-correction/with_skill/outputs/transcript.txt", "value": "OpenTelemetry", "case_insensitive": false},
        {"name": "split product spelling is absent", "type": "not_contains", "path": "eval-context-correction/with_skill/outputs/transcript.txt", "value": "open telemetry", "case_insensitive": true},
        {"name": "canonical transcript retains raw product wording", "type": "contains", "path": "eval-context-correction/with_skill/outputs/transcript.json", "value": "open telemetry", "case_insensitive": true}
      ]
    },
    {
      "id": 3,
      "prompt": "A course directory in the current directory contains conference welcome clips at the top level and in a nested module. Transcribe the whole directory recursively and apply the shared context file to every transcript.",
      "expected_output": "One .cue output directory beside each source clip, including the nested clip, with both transcripts corrected from one explicitly supplied shared corrections manifest.",
      "files": [
        "evals/files/clip-01.mp3",
        "evals/files/clip-02.mp3",
        "evals/files/context.md"
      ],
      "assertions": [
        {"name": "shared manifest maps the product term", "type": "contains", "path": "eval-recursive-context/with_skill/outputs/corrections.md", "value": "open telemetry -> OpenTelemetry", "case_insensitive": true},
        {"name": "top-level transcript is non-empty", "type": "file_nonempty", "path": "eval-recursive-context/with_skill/outputs/course/clip-01.cue/transcript.txt"},
        {"name": "nested transcript is non-empty", "type": "file_nonempty", "path": "eval-recursive-context/with_skill/outputs/course/module-02/clip-02.cue/transcript.txt"},
        {"name": "top-level speaker uses Doe", "type": "contains", "path": "eval-recursive-context/with_skill/outputs/course/clip-01.cue/transcript.txt", "value": "John Doe", "case_insensitive": true},
        {"name": "top-level canonical transcript retains raw wording", "type": "contains", "path": "eval-recursive-context/with_skill/outputs/course/clip-01.cue/transcript.json", "value": "open telemetry", "case_insensitive": true},
        {"name": "nested speaker uses Doe", "type": "contains", "path": "eval-recursive-context/with_skill/outputs/course/module-02/clip-02.cue/transcript.txt", "value": "John Doe", "case_insensitive": true},
        {"name": "nested product uses OpenTelemetry", "type": "contains", "path": "eval-recursive-context/with_skill/outputs/course/module-02/clip-02.cue/transcript.txt", "value": "OpenTelemetry", "case_insensitive": false},
        {"name": "nested split product spelling is absent", "type": "not_contains", "path": "eval-recursive-context/with_skill/outputs/course/module-02/clip-02.cue/transcript.txt", "value": "open telemetry", "case_insensitive": true},
        {"name": "nested canonical transcript retains raw wording", "type": "contains", "path": "eval-recursive-context/with_skill/outputs/course/module-02/clip-02.cue/transcript.json", "value": "open telemetry", "case_insensitive": true}
      ]
    },
    {
      "id": 4,
      "prompt": "There are two media files in this directory, but one already has a corrected .cue output folder. Transcribe only the new clip, then write a corrections.md manifest for the misheard terms and apply it with cue correct without rerendering the existing output.",
      "expected_output": "Only the new clip is transcribed; a corrections.md manifest maps the misheard term to its context spelling, and the pre-existing transcript.txt is corrected via cue correct with its sentinel and transcript.json left untouched.",
      "files": [
        "evals/files/clip-01.mp3",
        "evals/files/context.md"
      ],
      "assertions": [
        {"name": "manifest maps the garbled term", "type": "contains", "path": "eval-existing-correction/with_skill/outputs/corrections.md", "value": "open telemetry -> OpenTelemetry", "case_insensitive": true},
        {"name": "existing transcript is non-empty", "type": "file_nonempty", "path": "eval-existing-correction/with_skill/outputs/1. welcome.cue/transcript.txt"},
        {"name": "existing transcript is corrected", "type": "contains", "path": "eval-existing-correction/with_skill/outputs/1. welcome.cue/transcript.txt", "value": "OpenTelemetry", "case_insensitive": false},
        {"name": "existing transcript has no garble", "type": "not_contains", "path": "eval-existing-correction/with_skill/outputs/1. welcome.cue/transcript.txt", "value": "open telemetry", "case_insensitive": true},
        {"name": "existing transcript sentinel survives", "type": "contains", "path": "eval-existing-correction/with_skill/outputs/1. welcome.cue/transcript.txt", "value": "PRE-EXISTING OUTPUT SENTINEL", "case_insensitive": false},
        {"name": "existing subtitles are corrected", "type": "contains", "path": "eval-existing-correction/with_skill/outputs/1. welcome.cue/subtitles.srt", "value": "OpenTelemetry", "case_insensitive": false},
        {"name": "canonical transcript is unchanged", "type": "files_equal", "path": "eval-existing-correction/with_skill/outputs/1. welcome.cue/transcript.json", "other_path": ".baselines/with_skill-transcript.json"},
        {"name": "new clip transcript is non-empty", "type": "file_nonempty", "path": "eval-existing-correction/with_skill/outputs/2. what we cover.cue/transcript.txt"}
      ]
    },
    {
      "id": 5,
      "prompt": "Transcribe the two explicitly named conference clips in the current directory in one cue command.",
      "expected_output": "Two sibling .cue output directories, one per explicitly supplied media file.",
      "files": [
        "evals/files/clip-01.mp3",
        "evals/files/clip-02.mp3"
      ],
      "assertions": [
        {"name": "first explicit-file transcript is non-empty", "type": "file_nonempty", "path": "eval-explicit-multi/with_skill/outputs/clip-01.cue/transcript.txt"},
        {"name": "second explicit-file transcript is non-empty", "type": "file_nonempty", "path": "eval-explicit-multi/with_skill/outputs/clip-02.cue/transcript.txt"}
      ]
    }
  ]
}
